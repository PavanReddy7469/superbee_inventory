# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=superbee_inventory
DB_CA_CERT=path/to/ca.pem
DB_CLIENT_CERT=path/to/client-cert.pem
DB_CLIENT_KEY=path/to/client-key.pem
# Azure MySQL: download CA from 
# https://dl.cacerts.digicert.com/DigiCertGlobalRootCA.crt.pem


# JWT Configuration
JWT_SECRET=generate_with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
