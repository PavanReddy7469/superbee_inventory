# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# FOR IT DEPARTMENT: Configure these values for production deployment
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# UPDATE THESE WITH YOUR PRODUCTION DATABASE CREDENTIALS
DB_HOST=localhost
DB_PORT=3306
DB_USER=superbee_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_NAME=superbee_inventory

# JWT Configuration (ALREADY CONFIGURED - DO NOT CHANGE)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=24h

# CORS Configuration
# UPDATE THIS WITH YOUR PRODUCTION DOMAIN
CORS_ORIGIN=https://your-domain.com

# ============================================
# DEPLOYMENT INSTRUCTIONS:
# ============================================
# 1. Rename this file to .env (remove .production)
# 2. Update DB_PASSWORD with a strong secure password
# 3. Update CORS_ORIGIN with your actual domain
# 4. If database is on different server, update DB_HOST
# 5. Keep JWT_SECRET as is (already secure)
# ============================================
