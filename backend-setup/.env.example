# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=superbee_inventory

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_256_bit_minimum
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Admin User (Initial Setup)
ADMIN_EMAIL=ram@superbee.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Ram
ADMIN_EMPLOYEE_ID=EMP001
