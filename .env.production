# ============================================
# FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# FOR IT DEPARTMENT: Configure this before building frontend
# ============================================

# Backend API URL
# UPDATE THIS WITH YOUR PRODUCTION BACKEND URL
VITE_API_URL=https://inventory.superbeeaeronautics.com/api

# ============================================
# EXAMPLES:
# ============================================
# If backend is at: https://superbee.yourdomain.com
# Then use: VITE_API_URL=https://superbee.yourdomain.com/api
#
# If using subdomain: https://api.superbee.com
# Then use: VITE_API_URL=https://api.superbee.com/api
# ============================================

# ============================================
# DEPLOYMENT INSTRUCTIONS:
# ============================================
# 1. Rename this file to .env (remove .production)
# 2. Update VITE_API_URL with your backend URL
# 3. Make sure URL ends with /api
# 4. Use HTTPS (not HTTP) for production
# 5. Run: npm run build
# 6. Deploy the 'dist' folder to your web server
# ============================================
